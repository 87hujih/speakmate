APP_PORT=8080

# storage: memory or mysql
STORAGE_MODE=memory
MYSQL_DSN=

# LLM defaults use mock agents and do not call external services.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_USE_MOCK=true

CORRECTION_USE_MOCK=true
SCORING_USE_MOCK=true
SUMMARY_USE_MOCK=true
FEEDBACK_FAIL_OPEN=true
