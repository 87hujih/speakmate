# SpeakMate AI environment example.
# Copy values into your local shell, a local .env loader, or Docker Compose .env.
# Keep real API keys out of git. Mock mode is the safe default.

# ---------------------------------------------------------------------------
# App server
# ---------------------------------------------------------------------------
APP_PORT=8080
REQUEST_TIMEOUT_SECONDS=30
REQUEST_BODY_LIMIT_BYTES=12582912
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
EXTERNAL_SERVICE_TIMEOUT_SECONDS=30

# Local Vite dev server CORS. Add deployed origins as a comma-separated list.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_METHODS=GET,POST,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=false

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Local development default. Use memory when you do not need persistence.
STORAGE_MODE=memory

# Local MySQL example. Switch STORAGE_MODE=mysql before using it.
MYSQL_DSN=speakmate:speakmate@tcp(127.0.0.1:3306)/speakmate?parseTime=true&loc=UTC

# Docker Compose uses service DNS names, so keep compose DSN separate from the
# local MYSQL_DSN above.
COMPOSE_STORAGE_MODE=mysql
COMPOSE_MYSQL_DATABASE=speakmate
COMPOSE_MYSQL_USER=speakmate
COMPOSE_MYSQL_PASSWORD=speakmate
COMPOSE_MYSQL_ROOT_PASSWORD=speakmate-root
COMPOSE_MYSQL_DSN=speakmate:speakmate@tcp(mysql:3306)/speakmate?parseTime=true&loc=UTC
COMPOSE_MYSQL_PORT=3306

# ---------------------------------------------------------------------------
# Redis short-lived session state and event bus
# ---------------------------------------------------------------------------
# Keep false for local development and automated tests that do not need Redis.
# When true, the backend pings Redis at startup and fails clearly if Redis is
# unavailable. Runtime Redis state/event write failures are not silently
# downgraded to memory mode.
REDIS_ENABLED=false
REDIS_ADDR=127.0.0.1:6379
COMPOSE_REDIS_ADDR=redis:6379
COMPOSE_REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_SECONDS=30

# Redis keys and TTLs used by the backend:
# session:{id}:messages       List, current training context snapshot, 2h
# session:{id}:state          Hash, current stage/turn/status, 2h
# session:{id}:partial_score  Hash, latest temporary score, 2h
# session:{id}:corrections    List, temporary correction summaries, 2h
# session:{id}:events         Pub/Sub channel + retained List, 30m
# ws:{session_id}:connection  Hash, WebSocket connection state, 30m

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
# Mock is the safe default. Set LLM_USE_MOCK=false with all required fields to
# use an OpenAI-compatible provider for real AI reply streaming.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_USE_MOCK=true
LLM_FALLBACK_TO_MOCK=true

CORRECTION_USE_MOCK=true
SCORING_USE_MOCK=true
SUMMARY_USE_MOCK=true
FEEDBACK_FAIL_OPEN=true

# ---------------------------------------------------------------------------
# ASR
# ---------------------------------------------------------------------------
# Mock keeps local demo and automated tests available without cloud keys.
ASR_PROVIDER=mock
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
ASR_TIMEOUT_SECONDS=30
ASR_USE_MOCK=true

# Tencent Cloud ASR FlashRecognizer. Keep real SecretId/SecretKey/AppID only in
# your local environment or deployment secret store; never commit real values.
# To enable:
# ASR_PROVIDER=tencent
# ASR_USE_MOCK=false
TENCENT_ASR_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_ENGINE_TYPE=16k_en
TENCENT_ASR_VOICE_FORMAT=ogg-opus
TENCENT_ASR_HOTWORD_ID=
TENCENT_ASR_HOTWORD_LIST=
TENCENT_ASR_CUSTOMIZATION_ID=
TENCENT_ASR_FILTER_DIRTY=0
TENCENT_ASR_FILTER_MODAL=0
TENCENT_ASR_FILTER_PUNC=0
TENCENT_ASR_CONVERT_NUM_MODE=1
TENCENT_ASR_WORD_INFO=0

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# For local Vite dev, put this value in web/.env.local or export it in the web
# shell. Docker frontend defaults to /api/v1 and proxies through Nginx.
VITE_API_BASE_URL=http://localhost:8080/api/v1
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=5173
